# PWA mode — used when building for web/cloud deployment (npm run build:pwa)
# Hosted at: https://popmyc-pos-app.onrender.com  (free Render static site)
#
# When you buy a domain, update VITE_APP_URL here and:
#   1. Add domain to Render static site "Custom Domains"
#   2. Add domain to CORS_ALLOWED_ORIGINS env var on the Render backend service
#
VITE_API_URL=https://popmyc-pos.onrender.com/api/v1
VITE_CLOUD_LICENSE_URL=https://popmyc-pos.onrender.com
VITE_APP_URL=https://popmyc-pos-app.onrender.com
VITE_IS_PWA=true
