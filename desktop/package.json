{
  "name": "popmyc-pos-desktop",
  "version": "1.2.0",
  "description": "POPMYC POS Desktop Application",
  "author": "POPMyC Solutions <popmychubsolution@gmail.com>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "copy:frontend": "node scripts/copy-frontend.js",
    "download:pg": "node scripts/download-pg-installer.js",
    "build": "node scripts/copy-frontend.js && npx electron-builder --win --x64",
    "build:dir": "node scripts/copy-frontend.js && npx electron-builder --win --x64 --dir",
    "pack": "node scripts/copy-frontend.js && npx electron-builder --dir",
    "build:unpacked": "node scripts/copy-frontend.js && npx electron-builder --win --x64 --dir",
    "build:installer": "node scripts/build-installer.js",
    "publish:beta": "node scripts/publish-release.js --channel beta",
    "publish:stable": "node scripts/publish-release.js --channel stable"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.popmyc.pos",
    "productName": "POPMYC POS",
    "copyright": "Copyright © 2025 POPMyC Solutions",
    "directories": {
      "output": "dist-installer",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "service-manager.js",
      "splash.html",
      "db-setup.html",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/.venv-prod/**",
          "!**/venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/node_modules/**",
          "!**/.pytest_cache/**",
          "!**/pytest.ini",
          "!**/pyproject.toml",
          "!**/conftest.py",
          "!**/*_test.py",
          "!**/test_*.py",
          "!**/tests/**",
          "!**/audit_stage4/**",
          "!**/.env",
          "!**/.env.example",
          "!**/desktop_data/**",
          "!**/media/**",
          "!**/logs/**"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": "POPMyC Solutions",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POPMYC POS",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "PopmycSolution",
      "repo": "POPMYC-POS",
      "releaseType": "release"
    }
  }
}
