# POPMYC POS — Environment Variables
# Copy this file to .env and fill in your values.
# For desktop installs, this file lives in %APPDATA%\POPMYC POS\.env
# Never commit the real .env to source control.

# ══════════════════════════════════════════════════════════════════════════════
# LOCAL DESKTOP DATABASE (PostgreSQL on the customer's machine)
# ══════════════════════════════════════════════════════════════════════════════
# These variables are used when DATABASE_URL is NOT set (i.e. the local
# Windows desktop installation).  Leave them as-is for the desktop build.

DB_NAME=popmyc_pos
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ══════════════════════════════════════════════════════════════════════════════
# CLOUD DATABASE  (Render / Supabase)
# ══════════════════════════════════════════════════════════════════════════════
# Set DATABASE_URL when deploying to Render/Supabase.
# When DATABASE_URL is present the DB_* variables above are IGNORED.
# Leave blank (or omit entirely) for local desktop deployments.
#
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
DATABASE_URL=

# SSL mode for the cloud database connection.
# Defaults to "require" when DATABASE_URL is set (correct for Supabase).
# Set to "disable" only for local testing with a DATABASE_URL pointing at
# a local PostgreSQL instance that does not have SSL enabled.
DB_SSLMODE=require

# ══════════════════════════════════════════════════════════════════════════════
# DJANGO CORE
# ══════════════════════════════════════════════════════════════════════════════
# Generate a strong secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-with-django-get-random-secret-key

DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames.
# Local:  localhost,127.0.0.1
# Cloud:  your-app.onrender.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ══════════════════════════════════════════════════════════════════════════════
# CSRF  (required for cloud deployments behind HTTPS proxies)
# ══════════════════════════════════════════════════════════════════════════════
# Comma-separated list of trusted HTTPS origins for CSRF validation.
# Required when the app is served behind Render's TLS proxy or a CDN.
# Leave blank for local desktop use.
#
# Example: https://popmyc.onrender.com,https://app.popmycsolutions.com
CSRF_TRUSTED_ORIGINS=

# ══════════════════════════════════════════════════════════════════════════════
# CORS
# ══════════════════════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000

# ══════════════════════════════════════════════════════════════════════════════
# CLOUD / PWA FEATURE FLAGS
# ══════════════════════════════════════════════════════════════════════════════
# Set to True on the cloud server to enable cloud API and PWA endpoints.
# Leave False for local desktop deployments (offline-first mode).
CLOUD_ENABLED=False
PWA_ENABLED=False

# ══════════════════════════════════════════════════════════════════════════════
# CLOUD SYNCHRONIZATION
# ══════════════════════════════════════════════════════════════════════════════
# Leave blank for offline-only operation.
SYNC_CLOUD_URL=
SYNC_CLOUD_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
# CELERY / REDIS  (optional for desktop)
# ══════════════════════════════════════════════════════════════════════════════
# Set POPMYC_CELERY_EAGER=True to run background tasks synchronously
# (no Redis required — correct for desktop operation).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
POPMYC_CELERY_EAGER=True

# ══════════════════════════════════════════════════════════════════════════════
# DESKTOP-SPECIFIC
# ══════════════════════════════════════════════════════════════════════════════
# Set automatically by the Electron launcher — do not change manually.
# POPMYC_DATA_DIR=C:\Users\<name>\AppData\Roaming\POPMYC POS
